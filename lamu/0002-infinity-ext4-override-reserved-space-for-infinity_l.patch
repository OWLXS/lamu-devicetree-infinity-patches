From 47281e2c0e4d46e600235eea70ee1636c22f601d Mon Sep 17 00:00:00 2001
From: vigaz <pudimdebacon3@gmail.com>
Date: Sat, 10 Oct 2026 22:18:56 -0300
Subject: [PATCH 2/5] infinity: ext4 override + reserved space for
 infinity_lamu (post-boot MindTheGapps flash)

---
 BoardConfig.mk | 24 ++++++++++++++++++++++++
 1 file changed, 24 insertions(+)

diff --git a/BoardConfig.mk b/BoardConfig.mk
index cac5ff1..43013b7 100644
--- a/BoardConfig.mk
+++ b/BoardConfig.mk
@@ -20,6 +20,30 @@ BOARD_SUPER_PARTITION_SIZE := 8589934592
 # Inherit from common tree
 include device/motorola/mt6768-common/BoardConfigCommon.mk
 
+# infinity_lamu (vanilla, no GApps baked in) needs system/product/system_ext
+# writable after first boot so MindTheGapps can be flashed separately later
+# -- erofs has no rw path in the kernel driver at all (confirmed against the
+# real MindTheGapps installer: it does a plain `mount -o rw`, no mkfs.erofs/
+# repack logic), so the base erofs default from BoardConfigCommon.mk above
+# would make that flash fail outright regardless of free space. Scoped to
+# this one product only: infinity_lamu_gapps (and lineage_lamu/custom_lamu)
+# keep the erofs default, since they don't need a post-boot rw flash.
+ifeq ($(TARGET_PRODUCT),infinity_lamu)
+BOARD_SYSTEMIMAGE_FILE_SYSTEM_TYPE := ext4
+BOARD_PRODUCTIMAGE_FILE_SYSTEM_TYPE := ext4
+BOARD_SYSTEM_EXTIMAGE_FILE_SYSTEM_TYPE := ext4
+
+# Reserve free space so MindTheGapps (flashed separately post-boot) has
+# room to grow into -- these images otherwise build shrink-wrapped to
+# exactly their vanilla content size (dynamic-partition logical images
+# have no slack by default), so the GApps installer's plain `mount -o
+# rw` + file copy fails with ENOSPC even though the ext4 fix above makes
+# the mount itself rw-capable.
+BOARD_SYSTEMIMAGE_PARTITION_RESERVED_SIZE := 262144000
+BOARD_PRODUCTIMAGE_PARTITION_RESERVED_SIZE := 1215719042
+BOARD_SYSTEM_EXTIMAGE_PARTITION_RESERVED_SIZE := 124828018
+endif
+
 # Display
 TARGET_SCREEN_DENSITY := 400
 
